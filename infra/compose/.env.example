# Copy to infra/compose/.env (never commit the real file). Generate secrets with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# --- Required ---------------------------------------------------------------------------
POSTGRES_PASSWORD=change-me-owner-password          # schema owner; used only by migrations
RELUAI_APP_DB_PASSWORD=change-me-app-password       # least-privilege runtime role
RELUAI_VISITOR_HASH_SECRET=change-me-32-random-bytes # keyed hash for anonymous visitor quotas

# --- Production only --------------------------------------------------------------------
DOMAIN=reluai.cloud
ACME_EMAIL=you@example.com          # Let's Encrypt expiry notices
GHCR_OWNER=uzairazhar89
IMAGE_TAG=                          # set by the deploy script (git SHA)

# --- Optional ---------------------------------------------------------------------------
RELUAI_LOG_LEVEL=INFO
RELUAI_LLM_GROQ_API_KEY=            # free tier; demos fall back to local/deterministic without it
RELUAI_LLM_CEREBRAS_API_KEY=
RELUAI_LLM_LOCAL_ENABLED=false      # true after starting the `llm` profile
