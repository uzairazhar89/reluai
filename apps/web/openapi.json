{
  "openapi": "3.1.0",
  "info": {
    "title": "reluai.cloud API",
    "description": "\nBackend for [reluai.cloud](https://reluai.cloud) \u2014 portfolio demonstrations running on a\n2-vCPU / 8 GB VPS. All demos work without paid APIs.\n",
    "version": "0.0.0-dev"
  },
  "paths": {
    "/api/status": {
      "get": {
        "tags": [
          "status"
        ],
        "summary": "Get Status",
        "operationId": "get_status_api_status_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusOut"
                }
              }
            }
          }
        }
      }
    },
    "/api/contact": {
      "post": {
        "tags": [
          "contact"
        ],
        "summary": "Post Contact",
        "description": "Send a message. Limited to 3 per hour and 6 per day per visitor.",
        "operationId": "post_contact_api_contact_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ContactIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactAccepted"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/pipeline/summary": {
      "get": {
        "tags": [
          "pipeline"
        ],
        "summary": "Get Summary",
        "description": "Dashboard tiles: last run, last success, totals, recent trend and queue state.",
        "operationId": "get_summary_api_pipeline_summary_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SummaryOut"
                }
              }
            }
          }
        }
      }
    },
    "/api/pipeline/results": {
      "get": {
        "tags": [
          "pipeline"
        ],
        "summary": "Get Results",
        "description": "Measured results per drop (latest successful run of each), for the project page.",
        "operationId": "get_results_api_pipeline_results_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResultsOut"
                }
              }
            }
          }
        }
      }
    },
    "/api/pipeline/runs": {
      "get": {
        "tags": [
          "pipeline"
        ],
        "summary": "Get Runs",
        "operationId": "get_runs_api_pipeline_runs_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RunOut"
                  },
                  "title": "Response Get Runs Api Pipeline Runs Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "pipeline"
        ],
        "summary": "Post Run",
        "description": "Queue a pipeline run. Limited per visitor and by overall queue capacity.",
        "operationId": "post_run_api_pipeline_runs_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunAccepted"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/pipeline/runs/{run_id}": {
      "get": {
        "tags": [
          "pipeline"
        ],
        "summary": "Get Run",
        "operationId": "get_run_api_pipeline_runs__run_id__get",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Run Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunDetailOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/pipeline/runs/{run_id}/quarantine": {
      "get": {
        "tags": [
          "pipeline"
        ],
        "summary": "Get Quarantine",
        "operationId": "get_quarantine_api_pipeline_runs__run_id__quarantine_get",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Run Id"
            }
          },
          {
            "name": "reason",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-z_]{3,40}$"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Reason"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 25,
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 20000,
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuarantinePage"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/pipeline/scenarios": {
      "get": {
        "tags": [
          "pipeline"
        ],
        "summary": "Get Scenarios",
        "operationId": "get_scenarios_api_pipeline_scenarios_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ScenarioOut"
                  },
                  "type": "array",
                  "title": "Response Get Scenarios Api Pipeline Scenarios Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/pipeline/drops": {
      "get": {
        "tags": [
          "pipeline"
        ],
        "summary": "Get Drops",
        "operationId": "get_drops_api_pipeline_drops_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/DropOut"
                  },
                  "type": "array",
                  "title": "Response Get Drops Api Pipeline Drops Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/pipeline/reasons": {
      "get": {
        "tags": [
          "pipeline"
        ],
        "summary": "Get Reasons",
        "description": "Every reason code the validator can assign, with its explanation.",
        "operationId": "get_reasons_api_pipeline_reasons_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "additionalProperties": {
                      "type": "string"
                    },
                    "type": "object"
                  },
                  "type": "array",
                  "title": "Response Get Reasons Api Pipeline Reasons Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ComponentStatus": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "status": {
            "type": "string",
            "enum": [
              "operational",
              "degraded",
              "down"
            ],
            "title": "Status"
          },
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "name",
          "status",
          "detail"
        ],
        "title": "ComponentStatus"
      },
      "ContactAccepted": {
        "properties": {
          "received": {
            "type": "boolean",
            "title": "Received",
            "default": true
          }
        },
        "type": "object",
        "title": "ContactAccepted"
      },
      "ContactIn": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Name"
          },
          "email": {
            "type": "string",
            "maxLength": 320,
            "pattern": "^[^@\\s]{1,64}@[^@\\s]{1,255}\\.[A-Za-z]{2,}$",
            "title": "Email"
          },
          "company": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 120
              },
              {
                "type": "null"
              }
            ],
            "title": "Company"
          },
          "topic": {
            "type": "string",
            "pattern": "^(project|contract|full_time|consulting|other)$",
            "title": "Topic",
            "default": "project"
          },
          "message": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 20,
            "title": "Message"
          },
          "website": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Website",
            "description": "Leave empty"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "email",
          "message"
        ],
        "title": "ContactIn"
      },
      "DqOut": {
        "properties": {
          "check_name": {
            "type": "string",
            "title": "Check Name"
          },
          "dimension": {
            "type": "string",
            "title": "Dimension"
          },
          "stage": {
            "type": "string",
            "title": "Stage"
          },
          "severity": {
            "type": "string",
            "title": "Severity"
          },
          "passed": {
            "type": "boolean",
            "title": "Passed"
          },
          "observed": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Observed"
          },
          "threshold": {
            "type": "string",
            "title": "Threshold"
          },
          "weight": {
            "type": "number",
            "title": "Weight"
          },
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "check_name",
          "dimension",
          "stage",
          "severity",
          "passed",
          "observed",
          "threshold",
          "weight",
          "detail"
        ],
        "title": "DqOut"
      },
      "DropOut": {
        "properties": {
          "key": {
            "type": "string",
            "title": "Key"
          },
          "rows": {
            "type": "integer",
            "title": "Rows"
          },
          "loaded": {
            "type": "boolean",
            "title": "Loaded"
          },
          "first_loaded_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "First Loaded At"
          },
          "times_processed": {
            "type": "integer",
            "title": "Times Processed"
          }
        },
        "type": "object",
        "required": [
          "key",
          "rows",
          "loaded",
          "first_loaded_at",
          "times_processed"
        ],
        "title": "DropOut"
      },
      "DropResult": {
        "properties": {
          "drop_key": {
            "type": "string",
            "title": "Drop Key"
          },
          "run_id": {
            "type": "string",
            "format": "uuid",
            "title": "Run Id"
          },
          "finished_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "rows_read": {
            "type": "integer",
            "title": "Rows Read"
          },
          "rows_rejected": {
            "type": "integer",
            "title": "Rows Rejected"
          },
          "rows_deduplicated": {
            "type": "integer",
            "title": "Rows Deduplicated"
          },
          "rows_published": {
            "type": "integer",
            "title": "Rows Published"
          },
          "dq_score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dq Score"
          },
          "duration_ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration Ms"
          }
        },
        "type": "object",
        "required": [
          "drop_key",
          "run_id",
          "finished_at",
          "rows_read",
          "rows_rejected",
          "rows_deduplicated",
          "rows_published",
          "dq_score",
          "duration_ms"
        ],
        "title": "DropResult"
      },
      "DurationStats": {
        "properties": {
          "median_ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Median Ms"
          },
          "p95_ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "P95 Ms"
          },
          "max_ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Ms"
          }
        },
        "type": "object",
        "required": [
          "median_ms",
          "p95_ms",
          "max_ms"
        ],
        "title": "DurationStats"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LogOut": {
        "properties": {
          "ts": {
            "type": "string",
            "format": "date-time",
            "title": "Ts"
          },
          "level": {
            "type": "string",
            "title": "Level"
          },
          "event": {
            "type": "string",
            "title": "Event"
          },
          "fields": {
            "additionalProperties": true,
            "type": "object",
            "title": "Fields"
          }
        },
        "type": "object",
        "required": [
          "ts",
          "level",
          "event",
          "fields"
        ],
        "title": "LogOut"
      },
      "QuarantinePage": {
        "properties": {
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/QuarantineRowOut"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "total",
          "items"
        ],
        "title": "QuarantinePage"
      },
      "QuarantineRowOut": {
        "properties": {
          "line_number": {
            "type": "integer",
            "title": "Line Number"
          },
          "reason_code": {
            "type": "string",
            "title": "Reason Code"
          },
          "severity": {
            "type": "string",
            "title": "Severity"
          },
          "raw": {
            "additionalProperties": true,
            "type": "object",
            "title": "Raw"
          }
        },
        "type": "object",
        "required": [
          "line_number",
          "reason_code",
          "severity",
          "raw"
        ],
        "title": "QuarantineRowOut"
      },
      "ReasonCount": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "severity": {
            "type": "string",
            "title": "Severity"
          },
          "explanation": {
            "type": "string",
            "title": "Explanation"
          },
          "count": {
            "type": "integer",
            "title": "Count"
          }
        },
        "type": "object",
        "required": [
          "code",
          "label",
          "severity",
          "explanation",
          "count"
        ],
        "title": "ReasonCount"
      },
      "ResultsOut": {
        "properties": {
          "drops": {
            "items": {
              "$ref": "#/components/schemas/DropResult"
            },
            "type": "array",
            "title": "Drops"
          },
          "totals": {
            "$ref": "#/components/schemas/ResultsTotals"
          },
          "duration": {
            "$ref": "#/components/schemas/DurationStats"
          },
          "environment": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Environment"
          },
          "runs_succeeded": {
            "type": "integer",
            "title": "Runs Succeeded"
          },
          "runs_failed": {
            "type": "integer",
            "title": "Runs Failed"
          }
        },
        "type": "object",
        "required": [
          "drops",
          "totals",
          "duration",
          "environment",
          "runs_succeeded",
          "runs_failed"
        ],
        "title": "ResultsOut",
        "description": "Measured results: the latest successful run of every loaded drop."
      },
      "ResultsTotals": {
        "properties": {
          "drops": {
            "type": "integer",
            "title": "Drops"
          },
          "rows_read": {
            "type": "integer",
            "title": "Rows Read"
          },
          "rows_rejected": {
            "type": "integer",
            "title": "Rows Rejected"
          },
          "rows_deduplicated": {
            "type": "integer",
            "title": "Rows Deduplicated"
          },
          "rows_published": {
            "type": "integer",
            "title": "Rows Published"
          }
        },
        "type": "object",
        "required": [
          "drops",
          "rows_read",
          "rows_rejected",
          "rows_deduplicated",
          "rows_published"
        ],
        "title": "ResultsTotals"
      },
      "RunAccepted": {
        "properties": {
          "run_id": {
            "type": "string",
            "format": "uuid",
            "title": "Run Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "pending_runs": {
            "type": "integer",
            "title": "Pending Runs"
          }
        },
        "type": "object",
        "required": [
          "run_id",
          "status",
          "pending_runs"
        ],
        "title": "RunAccepted"
      },
      "RunDetailOut": {
        "properties": {
          "run": {
            "$ref": "#/components/schemas/RunOut"
          },
          "steps": {
            "items": {
              "$ref": "#/components/schemas/StepOut"
            },
            "type": "array",
            "title": "Steps"
          },
          "checks": {
            "items": {
              "$ref": "#/components/schemas/DqOut"
            },
            "type": "array",
            "title": "Checks"
          },
          "reasons": {
            "items": {
              "$ref": "#/components/schemas/ReasonCount"
            },
            "type": "array",
            "title": "Reasons"
          },
          "warnings": {
            "items": {
              "$ref": "#/components/schemas/ReasonCount"
            },
            "type": "array",
            "title": "Warnings"
          },
          "logs": {
            "items": {
              "$ref": "#/components/schemas/LogOut"
            },
            "type": "array",
            "title": "Logs"
          },
          "environment": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Environment"
          },
          "dq_formula": {
            "type": "string",
            "title": "Dq Formula",
            "default": "100 \u00d7 \u03a3(weight \u00d7 passed) / \u03a3(weight); weights: gate 3, warn 2, info 1"
          }
        },
        "type": "object",
        "required": [
          "run",
          "steps",
          "checks",
          "reasons",
          "warnings",
          "logs",
          "environment"
        ],
        "title": "RunDetailOut"
      },
      "RunOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "scenario": {
            "type": "string",
            "title": "Scenario"
          },
          "trigger": {
            "type": "string",
            "title": "Trigger"
          },
          "simulated": {
            "type": "boolean",
            "title": "Simulated"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "succeeded",
              "failed"
            ],
            "title": "Status"
          },
          "drop_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Drop Key"
          },
